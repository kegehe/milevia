{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Milevia",
  "version": "0.1.2",
  "identifier": "com.milevia.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web dev --host 127.0.0.1 --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../binaries/milevia-control.exe": "milevia-control.exe",
      "../binaries/milevia-approval.exe": "milevia-approval.exe",
      "../binaries/milevia-terminal-bridge.exe": "milevia-terminal-bridge.exe"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": "zh-CN",
        "bannerPath": "icons/wix-banner.bmp"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzRTA5REEyMEI3OTlEMjEKUldRaG5Ya0xvcDNnczVlUXBncU90d2lwRnVWaStqNlZXeTBLUWpTYVY2b2M2Vy9LR0paS3NrZWsK",
      "endpoints": [
        "https://kegehe.github.io/milevia/latest.json"
      ]
    }
  }
}
