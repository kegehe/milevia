<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标的单色层，供 Android 13+ 的「主题化图标」（themed icon）使用。

     系统会把这里的非透明像素统一着色成主题色，所以只画 M 的形状、不带背景；
     颜色本身无所谓，这里是纯白。形状与 drawable/ic_launcher_foreground.xml
     完全一致（含描边范围 54×45，落在圆形遮罩半径 36 的安全圆内）—— 改那个文件时
     要同步改这里，否则主题化图标会和普通图标对不上。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M31.5,72 L31.5,36 L48,57 L64.5,36 L64.5,72"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M76.5,36 L76.5,72"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round" />
</vector>
