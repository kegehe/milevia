# 将此 server 块加入现有 Nginx 配置，并替换静态文件目录。
# 它只监听 8443，不改动 keyanjia.info 现有的 80/443 server。
server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    server_name keyanjia.info;

    # Remote snapshots include recent conversation messages and can exceed
    # Nginx's 1 MiB default request limit.
    client_max_body_size 8m;

    ssl_certificate /etc/letsencrypt/live/keyanjia.info/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/keyanjia.info/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /var/www/milevia/dist;
    index index.html;

    location = /health {
        proxy_pass http://127.0.0.1:8090/health;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /v1/ {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
