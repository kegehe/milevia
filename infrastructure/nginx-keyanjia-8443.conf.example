# 将此 server 块加入现有 Nginx 配置，并替换静态文件目录。
# 它只监听 8443，不改动 keyanjia.info 现有的 80/443 server。
server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    server_name keyanjia.info;

    # Remote snapshots include recent conversation messages and can exceed
    # Nginx's 1 MiB default request limit.
    client_max_body_size 8m;

    ssl_certificate /etc/letsencrypt/live/keyanjia.info/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/keyanjia.info/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /var/www/milevia/dist;
    index index.html;

    location = /health {
        proxy_pass http://127.0.0.1:8090/health;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /v1/ {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # 在线升级静态目录：latest.json + 安装包 exe。
    # 与下面 SPA 兜底不同，缺失文件直接 404（不回落 index.html），
    # 避免把 index.html 丢给 updater 导致归档解析/签名校验失败。
    # 对应 tauri.conf.json 的 updater endpoints 指向 https://keyanjia.info:8443/updates/latest.json。
    location /updates/ {
        root /var/www/milevia/dist;
        try_files $uri =404;
        add_header Cache-Control "no-cache";
        # 手机端是 Android WebView（origin=https://localhost），用 fetch 读这份清单属于跨源请求；
        # 缺这个头浏览器会直接拦掉，App 只能退回 GitHub 备用源（那份会落后一版，表现为"没有更新"）。
        add_header Access-Control-Allow-Origin "*" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
