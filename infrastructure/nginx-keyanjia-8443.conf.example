# 云端连接服务（apps/cloud-control）的 Nginx 站点配置。
#
# 8443 是 Milevia 客户端（桌面端 / Android APK / PWA）使用的唯一公网入口：
#   /          -> PWA 静态文件
#   /health    -> cloud-control
#   /v1/*      -> cloud-control（含 Agent WebSocket 与手机 SSE）
#   /updates/  -> 在线升级清单与安装包
#
# 80 端口只用于 Let's Encrypt HTTP-01 续期；ACME 路径必须用 ^~ 且放在
# 重定向之前，否则证书续期会被 301 吞掉。
#
# 注意：阿里云对未完成接入备案的域名会在 80 返回 ICP 拦截页，并在 8443
# 按 SNI 重置 TLS。这种情况下 HTTP-01 不可用，必须改用 DNS-01，或先完成
# 阿里云接入备案。若运营商拦截 80，同样改用 DNS-01。
server {
    listen 80;
    server_name keyanjia.info;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://keyanjia.info:8443$request_uri;
    }
}

server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    server_name keyanjia.info;

    # 后端 agentSnapshot 的 JSON 上限是 32 MiB（decodeWithLimit），
    # Nginx 默认 1 MiB 会先返回 413，导致大快照永远传不上来。
    client_max_body_size 40m;

    # 迁移期可先指向从旧服务器复制的桥接证书
    # （/etc/nginx/ssl/keyanjia.info/{fullchain,privkey}.pem）；
    # 用 certbot 重新签发后切回下面的 Let's Encrypt 路径。
    ssl_certificate /etc/letsencrypt/live/keyanjia.info/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/keyanjia.info/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /var/www/milevia/dist;
    index index.html;

    location = /health {
        proxy_pass http://127.0.0.1:8090/health;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /v1/ {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # 在线升级静态目录：latest.json + 安装包 exe。
    # 与下面 SPA 兜底不同，缺失文件直接 404（不回落 index.html），
    # 避免把 index.html 丢给 updater 导致归档解析/签名校验失败。
    # 对应 tauri.conf.json 的 updater endpoints 指向 https://keyanjia.info:8443/updates/latest.json。
    location /updates/ {
        root /var/www/milevia/dist;
        try_files $uri =404;
        add_header Cache-Control "no-cache";
        # 手机端是 Android WebView（origin=https://localhost），用 fetch 读这份清单属于跨源请求；
        # 缺这个头浏览器会直接拦掉，App 只能退回 GitHub 备用源（那份会落后一版，表现为"没有更新"）。
        add_header Access-Control-Allow-Origin "*" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
