POSTGRES_DB=auto_dev
POSTGRES_USER=auto_dev
POSTGRES_PASSWORD=change-this-for-local-use
POSTGRES_PORT=5432
CLOUD_CONTROL_PORT=8090
# 与 MILEVIA_CLOUD_ENROLLMENT_TOKEN 二选一：用注册令牌时这里留空。
MILEVIA_CLOUD_AGENT_TOKENS=
MILEVIA_CLOUD_ENROLLMENT_TOKEN=replace-release-enrollment-token
# 可留空：当前客户端使用配对令牌（手机）与 Agent 令牌（桌面），不依赖全局用户令牌。
MILEVIA_CLOUD_USER_TOKEN=
MILEVIA_CLOUD_APP_URL=https://keyanjia.info:8443
# 新服务器：只绑回环，由 Nginx 反代；留空会绑 :8090 全接口。
MILEVIA_CLOUD_ADDR=127.0.0.1:8090
VITE_CLOUD_URL=https://milevia.example.com
AUTO_REMOTE_AGENT_TOKEN=replace-local-agent-token
AUTO_REMOTE_CLOUD_URL=https://milevia.example.com
AUTO_REMOTE_CLOUD_TOKEN=replace-agent-token
MILEVIA_AGENT_ENROLLMENT_TOKEN=replace-release-enrollment-token

REDIS_PORT=6379

MINIO_ROOT_USER=auto_dev
MINIO_ROOT_PASSWORD=change-this-for-local-use
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
