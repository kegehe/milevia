# Local environment
.env
.env.*
!.env.example

# Runtime data
data/*
!data/.gitkeep
logs/

# MCP runtime config files. 默认落在 <DataDir>/mcp-runtime（通常已被 data/* 覆盖），
# 但 DataDir 可配置，故按目录名显式再排除一次，避免临时配置文件被误提交。
mcp-runtime/

# JavaScript tooling
node_modules/
.pnpm-store/
dist/
coverage/
*.tsbuildinfo

# Go build output
bin/
*.exe
*.exe~
*.test
*.out
apps/control-server/control-server

# Go test JSON log dumps (debugging artifacts)
.suite.json
.suite.txt

# Generated API and protocol files
packages/contracts/generated/

# Editor and operating-system files
.DS_Store
.idea/
.vscode/

# Local AI-agent tooling
.agents/
.claude/
agent/
.superpowers/

# The Agent source is tracked; keep the local Windows secret file ignored.
!apps/agent/
!apps/agent/internal/
!apps/agent/internal/*.go
!apps/agent/internal/agent/
!apps/agent/internal/agent/*.go
!apps/agent/start-agent.ps1
apps/agent/.env.windows
apps/desktop/binaries/*.env

# Local convenience files
/dev
/package-lock.json
apps/web/package-lock.json
apps/web/test-results/

# Release artifacts (regenerated by scripts/release.mjs; upload latest.json to Pages separately)
/release/

# Secrets & signing material — NEVER commit these (open-source repo)
*.key
*.key.pub
*.pem
*.pfx
*.p12
*milevia-updater-password*.txt
*.sig
!.env.example

# Databases (local runtime state)
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite3-journal
.tmp/

# Local workbench data and build leftovers
.workbuddy/
_tmp_*
